# ─── Required ────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Comma-separated Telegram numeric user IDs. Admins receive the daily
# scrape-failure report as a DM.
ADMIN_IDS=123456789,987654321

# Supabase project credentials (Project Settings → API).
# Use the SERVICE ROLE key (the "secret" one), NOT the anon/public key: the bot
# is the sole, server-side accessor and relies on bypassing Row-Level Security.
# Keep RLS ENABLED on every table (supabase_setup.sql does this) so the public
# anon key can't read/write your data. Both bot and scraper hard-fail without these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# ─── Render / webhook deployment (leave unset for local polling dev) ──────────
# Public HTTPS URL Telegram should POST updates to. When set, the bot runs in
# webhook mode AND starts the in-process scraper + keep-alive ping.
# WEBHOOK_URL=https://your-service.onrender.com/<BOT_TOKEN>
# WEBHOOK_SECRET=some_random_string
# PORT=8080

# ─── Optional tuning ──────────────────────────────────────────────────────────
# How often (minutes) the in-process scraper runs. Default: 15
# SCRAPE_INTERVAL_MIN=15
