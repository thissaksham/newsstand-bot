# ─── Required ────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Comma-separated Telegram numeric user IDs. Admins receive the daily
# scrape-failure report as a DM.
ADMIN_IDS=123456789,987654321

# Supabase project credentials (Project Settings → API).
# The bot and scraper both hard-fail without these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# ─── Render / webhook deployment (leave unset for local polling dev) ──────────
# Public HTTPS URL Telegram should POST updates to. When set, the bot runs in
# webhook mode AND starts the in-process magazine scraper + keep-alive ping.
# WEBHOOK_URL=https://your-service.onrender.com/<BOT_TOKEN>
# WEBHOOK_SECRET=some_random_string
# PORT=8080

# ─── Optional tuning ──────────────────────────────────────────────────────────
# How often (minutes) the in-process magazine scraper runs. Default: 15
# MAGAZINE_SCRAPE_INTERVAL_MIN=15
